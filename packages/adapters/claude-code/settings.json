{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Template settings.json for Claude Code projects using omnix. Verify schema against current Claude Code docs before relying on field names.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm test:*)",
      "Bash(npm run *:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run *:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {}
}
